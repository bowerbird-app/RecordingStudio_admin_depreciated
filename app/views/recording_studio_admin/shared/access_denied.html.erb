<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: @recording_studio_admin_access_denied_title,
    subtitle: @recording_studio_admin_access_denied_subtitle,
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "403 forbidden", style: :warning, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(
      text: "requires #{@recording_studio_admin_access_denied_required_role}",
      style: :info,
      size: :sm
    ) %>
    <%= render FlatPack::Badge::Component.new(
      text: recording_studio_admin_current_root_name,
      style: :default,
      size: :sm
    ) %>
  </div>

  <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
    <% card.header do %>
      <%= render FlatPack::PageTitle::Component.new(
        title: "Why this page is blocked",
        subtitle: "Recording Studio Admin is scoped to admin roots and can still apply stricter page-level roles.",
        variant: :h3,
        class: "mb-0 pb-0"
      ) %>
    <% end %>

    <% card.body do %>
      <p class="text-sm leading-6 text-(--surface-muted-content-color)">
        <%= @recording_studio_admin_access_denied_message %>
      </p>
    <% end %>

    <% card.footer do %>
      <div class="flex flex-wrap gap-3">
        <% if recording_studio_admin_root_switcher_path.present? %>
          <%= link_to recording_studio_admin_root_switcher_path, class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: recording_studio_admin_exit_root_label, style: :primary, size: :md) %>
          <% end %>
        <% end %>

        <% if recording_studio_admin_admin_users_path.present? && recording_studio_admin_admin_users_allowed? %>
          <%= link_to recording_studio_admin_admin_users_path, class: "inline-flex" do %>
            <%= render FlatPack::Button::Component.new(text: "Manage users", style: :primary, size: :md) %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>