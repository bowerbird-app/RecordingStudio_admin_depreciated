<%= render FlatPack::Sidebar::Component.new(side: :left) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Admin",
      subtitle: recording_studio_admin_current_root_name
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="space-y-1 py-4" aria-label="Recording Studio Admin navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Overview",
        href: main_app.recording_studio_admin.root_path(scope: recording_studio_admin_current_scope),
        icon: :home
      ) %>

      <% if recording_studio_admin_admin_users_path.present? %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Admin users",
          href: recording_studio_admin_admin_users_path,
          icon: :users
        ) %>
      <% end %>
    </nav>
  <% end %>
<% end %>
