<%= render FlatPack::Sidebar::Component.new(side: :left) do |sidebar| %>
  <% sidebar.header do %>
    <%= render FlatPack::Sidebar::Header::Component.new(
      brand_abbr: "RS",
      title: "Studio",
      subtitle: recording_studio_admin_current_root_name
    ) %>
  <% end %>

  <% sidebar.items do %>
    <nav class="space-y-1 py-4" aria-label="Recording Studio Admin navigation">
      <%= render FlatPack::Sidebar::Item::Component.new(
        label: "Home",
        href: recording_studio_admin_home_path,
        icon: :home
      ) %>

      <% if recording_studio_admin_pages_allowed? %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Pages",
          href: recording_studio_admin_pages_path,
          icon: :document_text
        ) %>
      <% end %>

      <% if recording_studio_admin_admin_users_path.present? && recording_studio_admin_admin_users_allowed? %>
        <%= render FlatPack::Sidebar::Item::Component.new(
          label: "Admin users",
          href: recording_studio_admin_admin_users_path,
          icon: :users
        ) %>
      <% end %>
    </nav>
  <% end %>
<% end %>
