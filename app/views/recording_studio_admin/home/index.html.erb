<div class="mx-auto flex w-full max-w-5xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Admin",
    subtitle: "A minimal admin root for RecordingStudio hosts.",
    variant: :h1
  ) %>

  <div class="flex flex-wrap gap-2">
    <%= render FlatPack::Badge::Component.new(text: "Mounted", style: :success, size: :sm) %>
    <%= render FlatPack::Badge::Component.new(
      text: RecordingStudioAdmin.admin_root_recording?(@root_recording) ? "Admin root" : "Standard root",
      style: RecordingStudioAdmin.admin_root_recording?(@root_recording) ? :info : :warning,
      size: :sm
    ) %>
    <%= render FlatPack::Badge::Component.new(
      text: "#{@current_role || :none} access",
      style: @current_role == :admin ? :success : (@current_role == :edit ? :warning : :default),
      size: :sm
    ) %>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <%= render FlatPack::Card::Component.new(style: :default) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Current root",
          subtitle: "The mounted page follows the current RecordingStudio root when one is available.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <dl class="grid gap-3 text-sm leading-6 sm:grid-cols-[8rem_1fr]">
          <dt class="font-medium text-(--surface-muted-content-color)">Name</dt>
          <dd><%= recording_studio_admin_current_root_name %></dd>

          <dt class="font-medium text-(--surface-muted-content-color)">Type</dt>
          <dd><%= @root_recordable&.class&.name || "Unavailable" %></dd>

          <% if @root_recordable.respond_to?(:key) && @root_recordable.key.present? %>
            <dt class="font-medium text-(--surface-muted-content-color)">Key</dt>
            <dd><%= @root_recordable.key %></dd>
          <% end %>

          <dt class="font-medium text-(--surface-muted-content-color)">Access</dt>
          <dd><%= @current_role || "Unavailable" %></dd>
        </dl>
      <% end %>
    <% end %>

    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.header do %>
        <%= render FlatPack::PageTitle::Component.new(
          title: "Admin users",
          subtitle: "Use RecordingStudioAccessible to manage root-level access for the current root.",
          variant: :h3,
          class: "mb-0 pb-0"
        ) %>
      <% end %>

      <% card.body do %>
        <p class="text-sm leading-6 text-(--surface-muted-content-color)">
          Recording Studio Admin keeps the addon surface narrow but root-scoped. Standard workspace roots stay outside
          this mounted admin surface, while admin-root pages can still enforce stricter access inside the admin root.
        </p>
      <% end %>

      <% card.footer do %>
        <div class="flex flex-wrap gap-3">
          <% if recording_studio_admin_admin_users_path.present? && recording_studio_admin_admin_users_allowed? %>
            <%= link_to recording_studio_admin_admin_users_path, class: "inline-flex" do %>
              <%= render FlatPack::Button::Component.new(
                text: "Admin users",
                style: :secondary,
                size: :md
              ) %>
            <% end %>
          <% end %>

          <% if recording_studio_admin_root_switcher_path.present? %>
            <%= link_to recording_studio_admin_root_switcher_path, class: "inline-flex" do %>
              <%= render FlatPack::Button::Component.new(
                text: "Switch root",
                style: :secondary,
                size: :md
              ) %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
