<div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Recording tree",
    subtitle: "Shows every root the current user can reach, along with the nested recording structure under each root.",
    variant: :h1
  ) %>

  <%= render FlatPack::Tree::Component.new(class: "rounded-xl border border-[var(--surface-border-color)] bg-[var(--surface-canvas-color)] p-3") do |tree| %>
    <% @root_recordings.each do |root_recording| %>
      <% build_tree_node(tree, root_recording) %>
    <% end %>
  <% end %>
</div>