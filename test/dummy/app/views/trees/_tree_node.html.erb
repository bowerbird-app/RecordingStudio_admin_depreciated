<div class="space-y-3">
  <div class="flex items-center gap-3 rounded-lg border border-[var(--surface-border-color)] bg-[var(--surface-page-background-color)] px-4 py-3">
    <span class="inline-flex h-2.5 w-2.5 rounded-full bg-[var(--brand-primary-color)]"></span>
    <div class="min-w-0 flex-1">
      <p class="truncate text-sm font-medium"><%= recording_label(recording) %></p>
      <p class="text-xs text-[var(--surface-muted-content-color)]"><%= recording.recordable.class.name %></p>
    </div>
  </div>

  <% if children_for(recording).any? %>
    <div class="ml-6 border-l border-dashed border-[var(--surface-border-color)] pl-4">
      <div class="space-y-3">
        <% children_for(recording).each do |child_recording| %>
          <%= render partial: "tree_node", locals: { recording: child_recording, depth: depth + 1 } %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>